# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/netatrack?schema=public"

# Scratch database used by `prisma migrate` to diff schemas.
# Prisma DROPS AND RECREATES whatever this points at, so it must be a database
# of its own — pointing it at the app database wipes local development data.
# Create it once with: createdb netatrack_shadow
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/netatrack_shadow"

# --- Sessions -------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-this-to-a-long-random-string-at-least-32-chars"

# --- Application ----------------------------------------------------------
APP_URL="http://localhost:3000"
APP_NAME="NetaTrack"

# --- SMTP (transactional email) -------------------------------------------
# Leave SMTP_HOST empty in development: mail is written to the notifications
# table and printed to the console instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NetaTrack <no-reply@netatrack.example>"

# --- Uploads --------------------------------------------------------------
# Local disk in dev; point at S3-compatible storage in production.
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_BYTES="5242880"
